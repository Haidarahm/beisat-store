</head>

<body class="template-{{ template | split: '.' | first | handle }}
    {%- if template.suffix %} template-suffix-{{ template.suffix }}{% endif -%}
    {%- if settings.swatch_source == 'native' %} swatch-source-native swatch-method-swatches swatch-style-{{ settings.swatch_style }}
    {%- elsif settings.swatch_source == 'theme' %} swatch-source-theme swatch-method-{{ settings.swatch_method }} swatch-style-{{ settings.swatch_style }}{% endif -%}
    {%- if settings.animations_enabled_desktop %} cc-animate-enabled{% endif -%}
    ">

  <a class="skip-link visually-hidden" href="#content" data-cs-role="skip">{{ 'accessibility.skip_to_content' | t }}</a>
  {% comment %} ---START--- Edited by: Hasan | Date: 7/9/2026 | Reason: Added install app header {% endcomment %}
  {% render 'app-install-banner' %}
  {% comment %} ---END --- Edited by: Hasan | Date: 7/9/2026 | Reason: Added install app header {% endcomment %}
  {%- sections 'header-group' -%}

  <main id="content" role="main">
    <div class="container cf">

      {{ content_for_layout }}

    </div>
  </main>

  {%- if request.path != '/challenge' -%}
    <div id="pagefooter">
      {%- sections 'footer-group' -%}
    </div>

    {%- sections 'overlay-group' -%}
  {%- endif -%}


  <a href="#" class="page-shade" aria-label="{{ 'general.navigation.close' | t }}"></a>
  <div class="overlay fixed top-0 right-0 bottom-0 left-0 js-overlay"></div>

  {%- if settings.after_add_to_cart == 'notification' -%}
    {% comment %} ---START--- Edited by: Biswajit | Date: 29/9/2024 | Reason: change added to cart style like wishlist {% endcomment %}
    <style>
      .added-notification{left:30px !important; right:auto !important;--animate-duration: 0.2s;}
      .added-notification__message-area{
        margin-inline-end: 15px;
        margin-inline-start: 15px;
      }
      .added-notification__message-title{
        font-weight: bold !important;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        -webkit-box-orient: vertical;
      }
      .added-notification__message-text {
          margin-top: 7px;
          color: #000;
      }
      .added-notification__message-img img{width:50px}
      .added-notification__message-img{
        display:flex;
        align-items: center;
      }
    </style>
    <script src="{{ 'added-notification.js' | asset_url }}" defer></script>
    <template id="AddedNotification">
      <added-notification class="added-notification added-notification--hidden animate__animated">
        <a href="{{ routes.cart_url }}" style="display:flex" onclick="openCartDrawer(); return false;">
          <div class="added-notification__message-img"><img></div>
          <div class="added-notification__message-area">
            <div class="added-notification__message-title"></div>
            <div class="added-notification__message-text underline-child">{{ 'products.product.added_to_cart_with_link_html' | t: cart_url: routes.cart_url }}</div>
          </div>
        </a>
        <div class="added-notification__button-area">
          <button type="button" class="added-notification__close" aria-label="{{ 'general.icon_labels.close' | t | escape }}">
            {%- render 'icon-close' -%}
          </button>
        </div>
      </added-notification>
    </template>
    {% comment %} ---END--- Edited by: Biswajit | Date: 29/9/2024 | Reason: change added to cart style like wishlist {% endcomment %}
  {%- endif -%}



