{{ 'advanced-cart-preview.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign customer_location = ''
  if customer and customer.default_address
    assign customer_location = customer.default_address.address1
    if customer.default_address.city != blank and customer.default_address.city != 'N/A'
      assign customer_location = customer_location | append: ', ' | append: customer.default_address.city
    endif
    if customer.default_address.country != blank
      assign customer_location = customer_location | append: ', ' | append: customer.default_address.country
    endif
  endif
  assign cart_checkout_return = routes.root_url | append: 'checkout' | replace: '//checkout', '/checkout'
-%}
<div
  class="checkout advanced-cart-preview"
  id="advanced-cart-preview-root"
  data-countries-url="{{ 'advanced-cart-countries.json' | asset_url }}"
  data-map-url="{{ 'advanced-cart-map.json' | asset_url }}"
  data-visitor-country="{{ localization.country.name | escape }}"
  data-visitor-country-iso="{{ localization.country.iso_code | escape }}"
  {% if customer and customer.email != blank %}data-customer-email="{{ customer.email | escape }}"{% endif %}
  {% if customer_location != blank %}data-customer-location="{{ customer_location | escape }}"{% endif %}
>
  {% render 'advanced-cart-header' %}
  {% render 'advanced-cart-order-items' %}
  {% render 'advanced-cart-shipping' %}
  {% render 'advanced-cart-summary', section: section %}

  {% comment %} Save cart location onto the customer so checkout middle step is prefilled. {% endcomment %}
  {% if customer %}
    <div hidden id="cart-address-sync">
      {% if customer.default_address %}
        {% form 'customer_address', customer.default_address, return_to: cart_checkout_return %}
          <input type="hidden" name="address[first_name]" id="cart-addr-first-name" value="">
          <input type="hidden" name="address[last_name]" id="cart-addr-last-name" value="">
          <input type="hidden" name="address[phone]" id="cart-addr-phone" value="">
          <input type="hidden" name="address[address1]" id="cart-addr-address1" value="">
          <input type="hidden" name="address[city]" id="cart-addr-city" value="">
          <input type="hidden" name="address[province]" id="cart-addr-province" value="">
          <input type="hidden" name="address[zip]" id="cart-addr-zip" value="">
          <select name="address[country]" id="cart-addr-country">
            {{ all_country_option_tags }}
          </select>
          <input type="hidden" name="address[default]" value="1">
        {% endform %}
      {% else %}
        {% form 'customer_address', customer.new_address, return_to: cart_checkout_return %}
          <input type="hidden" name="address[first_name]" id="cart-addr-first-name" value="">
          <input type="hidden" name="address[last_name]" id="cart-addr-last-name" value="">
          <input type="hidden" name="address[phone]" id="cart-addr-phone" value="">
          <input type="hidden" name="address[address1]" id="cart-addr-address1" value="">
          <input type="hidden" name="address[city]" id="cart-addr-city" value="">
          <input type="hidden" name="address[province]" id="cart-addr-province" value="">
          <input type="hidden" name="address[zip]" id="cart-addr-zip" value="">
          <select name="address[country]" id="cart-addr-country">
            {{ all_country_option_tags }}
          </select>
          <input type="hidden" name="address[default]" value="1">
        {% endform %}
      {% endif %}
    </div>
  {% endif %}

  <div class="location-sheet" id="location-sheet" aria-hidden="true">
    <div class="location-sheet__backdrop" id="location-sheet-backdrop"></div>
    <div
      class="location-sheet__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="location-sheet-title"
    >
      <h2 id="location-sheet-title" class="location-sheet__title">{{ 'cart.advanced.select_location_map' | t }}</h2>
      <div class="location-sheet__search">
        <select
          id="location-country-filter"
          class="location-sheet__country"
          aria-label="{{ 'cart.advanced.filter_country' | t | escape }}"
        ></select>
        <svg class="location-sheet__search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="M20 20l-3.5-3.5" />
        </svg>
        <input
          id="location-search-input"
          class="location-sheet__input"
          type="search"
          placeholder="{{ 'cart.advanced.search_locations' | t | escape }}"
          autocomplete="off"
          aria-label="{{ 'cart.advanced.search_locations' | t | escape }}"
          aria-controls="location-search-results"
        >
      </div>
      <ul class="location-sheet__results" id="location-search-results" role="listbox"></ul>
    </div>
  </div>

  <div class="location-sheet" id="country-sheet" aria-hidden="true">
    <div class="location-sheet__backdrop" id="country-sheet-backdrop"></div>
    <div
      class="location-sheet__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="country-sheet-title"
    >
      <h2 id="country-sheet-title" class="location-sheet__title">{{ 'cart.advanced.select_country_code' | t }}</h2>
      <div class="location-sheet__search">
        <svg class="location-sheet__search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="M20 20l-3.5-3.5" />
        </svg>
        <input
          id="country-search-input"
          class="location-sheet__input"
          type="search"
          placeholder="{{ 'cart.advanced.search_country' | t | escape }}"
          autocomplete="off"
          aria-label="{{ 'cart.advanced.search_country' | t | escape }}"
          aria-controls="country-search-results"
        >
      </div>
      <ul class="location-sheet__results" id="country-search-results" role="listbox"></ul>
    </div>
  </div>
</div>

<script type="application/json" id="advanced-cart-i18n">
  {
    "change": {{ 'cart.advanced.change' | t | json }},
    "set_location": {{ 'cart.advanced.set_location' | t | json }},
    "use_current_location": {{ 'cart.advanced.use_current_location' | t | json }},
    "detecting_location": {{ 'cart.advanced.detecting_location' | t | json }},
    "location_unavailable": {{ 'cart.advanced.location_unavailable' | t | json }},
    "add_address": {{ 'cart.advanced.add_address' | t | json }},
    "full_name_required": {{ 'cart.advanced.full_name_required' | t | json }},
    "phone_required": {{ 'cart.advanced.phone_required' | t | json }},
    "phone_invalid": {{ 'cart.advanced.phone_invalid' | t | json }},
    "login_title": {{ 'cart.advanced.login_title' | t | json }},
    "login_text": {{ 'cart.advanced.login_text' | t | json }},
    "login_continue": {{ 'cart.advanced.login_continue' | t | json }},
    "login_dismiss": {{ 'cart.advanced.login_dismiss' | t | json }}
  }
</script>
<script src="{{ 'advanced-cart-location.js' | asset_url }}" defer></script>
<script src="{{ 'advanced-cart-phone.js' | asset_url }}" defer></script>
<script src="{{ 'advanced-cart-preview.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Advanced cart",
  "tag": "section",
  "class": "section-advanced-cart-preview",
  "settings": [
    {
      "type": "text",
      "id": "delivery_fee_label",
      "label": "Delivery fee display",
      "default": "0.900 OMR"
    }
  ],
  "presets": [
    {
      "name": "Advanced cart"
    }
  ]
}
{% endschema %}
