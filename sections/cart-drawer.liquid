<script>
   document.addEventListener('on:cart-drawer:before-open', function () {
     document.querySelectorAll('.custom-wishlist-button').forEach(function (item) {
       item.addEventListener('click', function () {
         moveToWishlist(item);
       });
     });

  {% comment %} animation for cart items {% endcomment %}

     const panel = event.target;
     const count = panel.querySelectorAll('.cart-item').length;
     if (!count) return;

     clearTimeout(window.cartItemsAnimTimer);
     panel.classList.remove('is-animating-items');
     panel.classList.add('is-preparing-items');

     const form = panel.querySelector('cart-form');
     let started = false;

     const start = () => {
       if (started) return;
       started = true;
       panel.removeEventListener('transitionend', onTransitionEnd);

       panel.classList.remove('is-preparing-items');
       void panel.offsetWidth;
       panel.classList.add('is-animating-items');

       window.cartItemsAnimTimer = setTimeout(() => {
         panel.classList.remove('is-animating-items');

       }, 500 + count * 90 + 50);
     };

     const onTransitionEnd = (e) => {
       if (e.target === panel) start();
     };

     panel.addEventListener('transitionend', onTransitionEnd);
     setTimeout(start, 700);

   });

   function moveToWishlist(item) {
     Swal.fire({
       title: "{{ 'cart.general.move_to_wishlist_confirmation' | t }}",
       allowOutsideClick: false,
       allowEscapeKey: false,
       showCancelButton: true,
       reverseButtons: true,
       confirmButtonText: "{{ 'cart.general.move_to_wishlist_ok' | t }}",
       cancelButtonText: "{{ 'cart.general.move_to_wishlist_cancel' | t }}",
       buttonsStyling: false,
       customClass: {
         confirmButton: 'btn',
         cancelButton: 'opt-label btn',
       },
     }).then((result) => {
       if (result.isConfirmed) {
         item.parentNode.closest('.cart-item__not-image').querySelector('.st-wishlist-button').click();
         item.parentNode.closest('.cart-item__not-image').querySelector('.cart-item__quantity-input').value = 1;
         item.parentNode.closest('.cart-item__not-image').querySelector('.quantity-down').click();
       }
     });
   }

   if (!window.xsellAddBound) {
     window.xsellAddBound = true;

     document.addEventListener('click', async (event) => {
       const button = event.target.closest('.xsell-card__add[data-variant-id]');
       if (!button) return;

       event.preventDefault();
       button.classList.add('is-loading');

       try {
         const response = await fetch('{{ routes.cart_add_url }}.js', {
           method: 'POST',
           headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
           body: JSON.stringify({ items: [{ id: Number(button.dataset.variantId), quantity: 1 }] }),
         });

         const data = await response.json();
         if (!response.ok) throw new Error(data.description || 'Could not add to cart');

         document.dispatchEvent(new CustomEvent('dispatch:cart-drawer:refresh', { bubbles: true }));
       } catch (error) {
         if (window.Swal) {
           Swal.fire({ icon: 'error', title: error.message });
         } else {
           alert(error.message);
         }
       } finally {
         button.classList.remove('is-loading');
       }
     });
   }
</script>
