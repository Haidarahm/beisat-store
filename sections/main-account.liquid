{% comment %} ---START--- Edited by: Biswajit | Date: 02/10/2024 | Reason: add auto checkout redirect {% endcomment %}
{% if customer.addresses_count > 0 %}
<script>
if(localStorage.getItem("checkout_url")){
  var url = localStorage.getItem("checkout_url");
  localStorage.removeItem("checkout_url");
  window.location.href = url;
}
</script>
{% else %}
<script>
  if(localStorage.getItem("checkout_url")){
    window.location.href = '{% if localization.language.iso_code == "ar" %}/ar{% endif %}/account/addresses?add=1';
  }
</script>
{% endif %}
{% comment %} ---END--- Edited by: Biswajit | Date: 02/10/2024 | Reason: add auto checkout redirect {% endcomment %}

<div class="container fully-spaced-row--small">
  <div class="spaced-row" {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
    <div class="lightly-spaced-row align-end">
      <a class="underline" href="{{ routes.account_logout_url }}">{{ 'customer.account.log_out' | t }}</a>
    </div>
    <h2 class="title align-center">{{ 'customer.account.title' | t }}</h2>
  </div>

  {% comment %} ---START--- Edited by: Hasan | Date: 03/12/2025 | Reason: Show user's coupons {% endcomment %}
  <div class="spaced-row" {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
    <h5 class="title">{{ 'customer.account.my_coupons' | t }}</h5>
    <div>
    {% assign link_lang ="" %}
    {% if localization.language.iso_code == "ar" %}
    {% assign link_lang = "/ar" %}
    {% endif %}

    {% assign coupons = customer.metafields.custom.coupons.value %}
    {% if coupons and coupons.size > 0 %}
      <div>
        {% for coupon in coupons %}
          {% assign details = coupon  | split: "|" %}
          {% assign now = "now" | date: "%s" %}          
          {% assign diff_seconds = details[1] | minus: now %}
          {% assign days_remaining = diff_seconds | divided_by: 86400 %}
          {% if details[1] > now %}
            <div>
              <a class="btn btn--secondary" style="display:block; width:100%; max-width:320px; margin:0 auto 12px;" href="{{ link_lang }}/discount/{{ details[0] }}">
                <b>{{ details[0] }}</b> : ({{ days_remaining }} {{ 'customer.account.day' | t }})
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <p>{{ 'customer.account.no_coupons' | t }}</p>
    {% endif %}
    </div>
  </div>
  {% comment %} ---END--- Edited by: Hasan | Date: 03/12/2025 | Reason: Show user's coupons {% endcomment %}

  <div class="cf">
    <div id="customer_sidebar" {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
      <div id="customer_detail" class="group">
        <h5 class="name">{{ customer.name }}</h5>
        <p class="email note">{{ customer.email }}</p>
        <div class="address note lightly-spaced-row">
          {% if customer.default_address != nil %}
            <p>{{ customer.default_address.address1 }}</p>
            {% if customer.default_address.address2 != "" %}
              <p>{{ customer.default_address.address2 }}</p>
            {% endif %}
            <p>{{ customer.default_address.city }}, {% if address.province_code %}{{ customer.default_address.province_code }}, {% endif %}{{ customer.default_address.country }}</p>
            <p>{{ customer.default_address.zip }}</p>
            <p class="address-phone">{{ customer.default_address.phone }}</p>
          {% endif %}
        </div>

        <a class="underline" href="{{ routes.account_addresses_url }}">{{ 'customer.account.view_addresses' | t }} ({{ customer.addresses_count }})</a>
      </div>
    </div>

    <div id="customer_orders" {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
      {% paginate customer.orders by 20 %}
        {% if customer.orders.size != 0 %}
          <link rel="stylesheet" href="{{ 'responsive-table.css' | asset_url }}">
          <script src="{{ 'responsive-table.js' | asset_url }}" defer></script>
          <responsive-table>
            <table class="responsive-table">
              <thead>
                <tr>
                  <th class="order_number">{{ 'customer.orders.order_number' | t }}</th>
                  <th class="date">{{ 'customer.orders.date' | t }}</th>
                  <th class="payment_status">{{ 'customer.orders.payment_status' | t }}</th>
                  <th class="fulfillment_status">{{ 'customer.orders.fulfillment_status' | t }}</th>
                  <th class="total">{{ 'customer.orders.total' | t }}</th>
                </tr>
              </thead>
              <tbody>
                {% for order in customer.orders %}
                <tr class="{% if order.cancelled %}cancelled_order{% endif %}">
                  <td class="responsive-table__cell-head">
                    <span class="responsive-table__cell-label">{{ 'customer.orders.order_number' | t }}</span>
                    <a class="underline" href="{{ order.customer_url }}">{{ order.name }}</a>
                    <span class="mobile-only">- {{ order.created_at | date: format: 'date' }}</span>
                    <span class="responsive-table__cell-head__icon">{% render 'icon-chevron-right' %}</span>
                  </td>
                  <td class="desktop-only">
                    <span class="note">{{ order.created_at | date: format: 'date' }}</span>
                  </td>
                  <td class="responsive-table__first-mobile-cell">
                    <span class="responsive-table__cell-label">{{ 'customer.orders.payment_status' | t }}</span>
                    <span class="status_{{ order.financial_status }}">{{ order.financial_status_label }}</span>
                  </td>
                  <td>
                    <span class="responsive-table__cell-label">{{ 'customer.orders.fulfillment_status' | t }}</span>
                    <span class="status_{{ order.fulfillment_status }}">{{ order.fulfillment_status_label }}</span>
                  </td>
                  <td>
                    <span class="responsive-table__cell-label">{{ 'customer.orders.total' | t }}</span>
                    <span class="total">
                      {%- if settings.cart_currency_code_enabled -%}
                        {{- order.total_price | money_with_currency -}}
                      {%- else -%}
                        {{- order.total_price | money -}}
                      {%- endif -%}
                    </span>

                    <div class="responsive-table__more">
                        <a href="{{ order.customer_url }}" class="underline">{{ 'customer.orders.view_order' | t }}</a>
                        {% assign requested = false %}
                        {% for tag in order.tags %}
                          {% if tag contains "Cancel:" %}
                            {% assign requested = true %}
                          {% endif %}
                        {% endfor %}
                       {% comment %} ---START--- Edited by: Hasan | Date: 3/01/2025 | Reason: Add self order cancel feature {% endcomment %}
                       {% if order.cancelled == false and order.financial_status == "pending" and order.fulfillment_status == "unfulfilled" and requested == false %}
                          <a id = "btn_cancel" class="underline" onclick="request_cancel()" style="margin-right: 1%;float: inline-end;color:#ff4a4a">{{ 'customer.orders.cancel_order' | t }}</a>
                         <script>
                           function request_cancel(){
                             Swal.fire({
                                title: '{{ 'customer.orders.cancel_dialog.choose_reason' | t }}' ,
                                icon: "question",
                                html: `
                                <select required id="option_reasons">
                                  <option value="" disabled selected hidden>{{ 'customer.orders.cancel_dialog.reason' | t }}</option>
                                  <option value="ByMistake">{{ 'customer.orders.cancel_dialog.reason1' | t }}</option>
                                  <option value="ChangedMind">{{ 'customer.orders.cancel_dialog.reason2' | t }}</option>
                                  <option value="ItemNotNeeded">{{ 'customer.orders.cancel_dialog.reason3' | t }}</option>
                                  <option value="DuplicateOrder">{{ 'customer.orders.cancel_dialog.reason4' | t }}</option>
                                  <option value="WrongItem">{{ 'customer.orders.cancel_dialog.reason5' | t }}</option>
                                  <option value="PaymentIssue">{{ 'customer.orders.cancel_dialog.reason6' | t }}</option>
                                  <option value="WrongLocation">{{ 'customer.orders.cancel_dialog.reason7' | t }}</option>
                                  <option value="VoucherIssue">{{ 'customer.orders.cancel_dialog.reason8' | t }}</option>
                                  <option value="PersonalFinance">{{ 'customer.orders.cancel_dialog.reason9' | t }}</option>
                                  <option value="UnexpectedExpenses">{{ 'customer.orders.cancel_dialog.reason10' | t }}</option>
                                  <option value="Traveling">{{ 'customer.orders.cancel_dialog.reason11' | t }}</option>
                                  <option value="Other">{{ 'customer.orders.cancel_dialog.reason12' | t }}</option>
                                </select>
                                `,
                                showCloseButton: true,
                                focusConfirm: false,
                                confirmButtonText: "{{ 'customer.orders.cancel_dialog.request_cancel' | t }}"
                              }).then((result) => {
                                  if (result.isConfirmed) {
                                    let reason = document.getElementById("option_reasons").value 
                                    if( reason == ""){
                                      Swal.fire("{{ 'customer.orders.cancel_dialog.invalid_reason' | t }}", "", "error");
                                    }else{
                                      send_request(reason);  
                                      // show loading animation
                                      Swal.fire({
                                        title: '{{ 'customer.orders.cancel_dialog.sending' | t }}',
                                        html: '{{ 'customer.orders.cancel_dialog.wait' | t }}',
                                        allowEscapeKey: false,
                                        allowOutsideClick: false,
                                        didOpen: () => {
                                          Swal.showLoading()
                                        }
                                      });
                                    }
                                  }
                                });        
                           }

                            function send_request(reason){
                             {% assign suffix = "now" | date: "%N" | modulo: 900 | plus: 100 %}
                              fetch("https://beisat.click/API/ShopifyCancelRequest/cancel.php?token={{ "now" | date: "%s" | plus: 300 | times: 5}}{{ suffix }}&reason=" + reason + "&order_id=" + "{{ order.id }}", {
                                  method: "POST",
                                  headers: {"Content-Type": "text/html; charset=utf-8"},
                                  body: reason
                              })
                              .then(response => response.json())
                              .then(data => {
                                   console.log("Success:", data);
                                   swal.close();//close previuos loading dialog
                                    // Hide cancell button so the user won't submit twice
                                    document.getElementById("btn_cancel").style.display = 'none';
                                   if (data.status == "success") { // Assuming the response contains a 'success' field
                                        Swal.fire({
                                            title: "Success",
                                            text: data.message,
                                            icon: "success"
                                        });
                                    } else {
                                        Swal.fire({
                                        title: "Error",
                                        text: data.message,
                                        icon: "error"
                                      });
                                    }
                                })
                                                  
                              .catch(error => {
                                    console.error("Error:", error);
                                    swal.close();//close previuos loading dialog
                                    Swal.fire({
                                      title: "Error",
                                      text: error,
                                      icon: "error"
                                    });
                              })            
                        }

                         </script>
                        {% endif %}
                      {% comment %} ---END--- Edited by: Hasan | Date: 30/01/2025 | Reason: Add self order cancel feature {% endcomment %}
                    </div>
                  </td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </responsive-table>
        {% else %}
          <p>{{ 'customer.orders.none' | t }}</p>
        {% endif %}

        <div class="pagination-row">{% render 'pagination-control', paginate: paginate %}</div>
      {% endpaginate %}
    </div>
  </div>
</div>
