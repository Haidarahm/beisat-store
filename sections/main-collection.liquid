{% comment %} ---START--- Edited by: Biswajit | Date: 23/10/2024 | Reason: fix collection slider width for desktop {% endcomment %}
<style>
  .slider__item{max-width: 400px}
</style>
{% comment %} ---END--- Edited by: Biswajit | Date: 23/10/2024 | Reason: fix collection slider width for desktop {% endcomment %}

<div data-section-id="{{ section.id }}" {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
{% paginate collection.products by section.settings.coll_num_per_page_int %}

{%- liquid
  if section.settings.show_image_behind_heading and collection.image
    assign header_image_enabled = true
  else
    assign header_image_enabled = false
  endif
  assign current_sort = collection.sort_by | default: collection.default_sort_by

  assign show_filters = section.settings.enable_filtering
  if collection.filters == empty
    assign show_filters = false
  endif
-%}

{%- liquid
  assign related_collections_count = 0
  if section.settings.related_collections != empty
    for loop_collection in section.settings.related_collections
      unless loop_collection.handle == collection.handle
        assign related_collections_count = related_collections_count | plus: 1
      endunless
    endfor
  endif
-%}

{%- if related_collections_count > 0 -%}
  {% capture related_collection_html %}
    {% if section.settings.related_collections_style == 'buttons' %}
      <div class="container{% if header_image_enabled %} container--not-mobile{% endif %} lightish-spaced-row-above">
        <related-collection-link-buttons class="related-collection-links related-collection-links--buttons align-center{% if header_image_enabled %} image-overlay__over{% endif %}" data-expander-btn-text="{{ 'sections.collection.view_all_related_collections' | t }}">
          {%- for loop_collection in section.settings.related_collections -%}
            {%- unless loop_collection.handle == collection.handle -%}
              <a class="btn btn--tertiary" href="{{ loop_collection.url }}">{{ loop_collection.title | escape }}</a>
            {%- endunless -%}
          {%- endfor -%}
        </related-collection-link-buttons>
      </div>
    {% else %}
      {% unless section.settings.rel_coll_gall_full_width %}
        <div class="container container--not-mobile lightish-spaced-row-above lightish-spaced-row-above--not-mobile{% if section.settings.rel_coll_grid_mobile == 'hide' %} desktop-only{% endif %}">
      {% endunless %}
      <div class="
        gallery
        gallery--height-adapt
        gallery--grid-desktop-{{ related_collections_count | at_most: 4 }}
        gallery--grid-mobile-{{ section.settings.rel_coll_grid_mobile }}
        {%- if section.settings.rel_coll_grid_mobile != 'hide' -%}
          {%- assign rel_coll_grid_mobile_int = section.settings.rel_coll_grid_mobile | plus: 0 -%}
          {%- if related_collections_count > rel_coll_grid_mobile_int %} gallery--mobile-carousel{% endif %}
        {%- endif -%}
        {%- if section.settings.rel_coll_gall_enable_margin %} gallery--with-margins{% endif %}
        related-collection-links
        related-collection-links--gallery
        {%- if section.settings.rel_coll_gall_full_width %} related-collection-links--is-full-width{% endif %}
        {%- if header_image_enabled %} related-collection-links--under-image-header{% endif %}
        {%- if section.settings.rel_coll_grid_mobile == 'hide' %} desktop-only{% endif %}">
        <carousel-slider class="carousel{% if section.settings.rel_coll_gall_mobile_layout == 'hide' %} desktop-only{% endif %}" inactive>
          <div class="slider slider--no-scrollbar" id="slider-{{ section.id }}">
            <div class="slider__grid">
              {%- for loop_collection in section.settings.related_collections -%}
                {% comment %} ---START--- Edited by: Biswajit | Date: 2/8/2025 | Reason: hide sub collection is no active item {% endcomment %}
                {%- if loop_collection.all_products_count > 0 -%}
                {% comment %} ---END--- Edited by: Biswajit | Date: 2/8/2025 | Reason: hide sub collection is no active item {% endcomment %}
                  {%- unless loop_collection.handle == collection.handle -%}
                    <div class="slider__item
                        gallery__item
                        image-overlay
                        image-overlay--bg-{{ section.settings.rel_coll_gall_overlay_style }}
                        image-overlay--edge-boxes
                        {% unless section.settings.rel_coll_gall_full_width and section.settings.rel_coll_gall_enable_margin == false %}image-overlay--edge-boxes--pad-to-corner{% endunless %}
                        ">
                      <a class="image-overlay__image-link" href="{{ loop_collection.url }}">
                        <div class="image-overlay__image gallery__image img-stretch">
                          {%- liquid
                            if loop_collection.featured_image
                              assign rel_coll_image = loop_collection.featured_image
                            else
                              assign rel_coll_image = false
                            endif
                            assign custom_aspect_ratio = section.settings.rel_coll_gall_aspect_ratio | times: 1.0
                          -%}
                          {%- if rel_coll_image -%}
                            {%- liquid
                              assign desktop_image_cols = section.settings.grid | at_most: section.blocks.size
                            -%}
                            {%- render 'image' with rel_coll_image, custom_aspect_ratio: custom_aspect_ratio, custom_crop: section.settings.image_position, size_cols_mobile: section.settings.rel_coll_grid_mobile, size_cols_desktop: desktop_image_cols -%}
                          {%- else -%}
                            <div class="placeholder-image dark">
                              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                            </div>
                          {%- endif -%}
                        </div>

                        <div class="text-overlay text-overlay--v-{{ section.settings.rel_coll_gall_text_alignment | split: ' ' | first }} text-overlay--h-{{ section.settings.rel_coll_gall_text_alignment | split: ' ' | last }} image-overlay__over">
                          <div class="text-overlay__inner">
                            <div class="text-overlay__text">
                              <h2 class="text-overlay__title h4">{{ loop_collection.title | escape }}</h2>
                            </div>
                          </div>
                        </div>
                      </a>
                    </div>
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
          <div class="slider-nav slider-nav--floating desktop-only no-js-hidden">
            <button type="button" class="slider-nav__btn has-ltr-icon" name="prev" aria-controls="slider-{{ section.id }}">
              <span class="visually-hidden">{{ 'general.slider.previous' | t }}</span>
              {%- render 'icon-chevron-left', stroke_width: 1.3 -%}
            </button>
            <button type="button" class="slider-nav__btn has-ltr-icon" name="next" aria-controls="slider-{{ section.id }}">
              <span class="visually-hidden">{{ 'general.slider.next' | t }}</span>
              {%- render 'icon-chevron-right', stroke_width: 1.3 -%}
            </button>
          </div>
        </carousel-slider>
      </div>
      {% unless section.settings.rel_coll_gall_full_width %}
        </div>
      {% endunless %}
    {% endif %}
  {% endcapture %}
{%- endif -%}

{% if header_image_enabled %}
  {%- liquid
    assign show_header = false
    if section.settings.show_title
      assign show_header = true
    endif
    if collection.description != blank and section.settings.coll_desc_pos == 'above'
      assign show_header = true
    endif
    if related_collections_count > 0 and section.settings.related_collections_style == 'buttons'
      assign show_header = true
    endif
  -%}
  {%- if show_header -%}
    <div class="page-header page-header--with-background img-fill image-overlay image-overlay--bg-{{ section.settings.overlay_style }} page-header--padded-{{ section.settings.heading_image_height }}">
      <div class="image-overlay__image">
        {%- render 'image' with collection.image, loading: 'eager', fetchpriority: 'high' -%}
      </div>
      <div class="text-overlay text-overlay--inline text-overlay--v-center text-overlay--h-center image-overlay__over" {%- render 'animation-attrs', attrs: 'data-cc-animate data-cc-animate-delay="0.2s"' -%}>
        <div class="text-overlay__inner">
          <div class="text-overlay__text">
            {%- if section.settings.show_title -%}
              <h1 class="text-overlay__title super-large-text">{{ collection.title | escape }}</h1>
            {%- endif -%}

            {% if collection.description != blank and section.settings.coll_desc_pos == 'above' %}
              <div class="text-overlay__rte rte cf align-center reading-width large-text">{{ collection.description }}</div>
            {% endif %}

            {%- if related_collections_count > 0 and section.settings.related_collections_style == 'buttons' -%}
              {{ related_collection_html }}
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}
{% else %}
  {{ related_collection_html }}
  {%- liquid
    assign show_header = false
    if section.settings.show_title
      assign show_header = true
    endif
    if collection.description != blank and section.settings.coll_desc_pos == 'above'
      assign show_header = true
    endif
  -%}
  {%- if show_header -%}

    <div class="page-header page-header--with-upper-spacing">
      <div class="container">
        {%- if section.settings.show_title -%}
          <h1 class="pagetitle h3">{{ collection.title | escape }}</h1>
        {%- endif -%}

        {% if collection.description != blank and section.settings.coll_desc_pos == 'above' %}
          <div class="rte cf align-center reading-width">{{ collection.description }}</div>
        {% endif %}
      </div>
    </div>
  {% endif %}
{% endif %}

  {%- if related_collections_count > 0 and header_image_enabled and section.settings.related_collections_style != 'buttons' -%}
    {{ related_collection_html }}
  {%- endif -%}

  <div class="container{% if settings.use_fullwidth_layout %} container--no-max{% endif %}{% if show_header == false %} lightly-spaced-row-above{% endif %}">
    <div class="utility-bar" data-ajax-container data-ajax-scroll-to>
      <div class="utility-bar__left">
        {% if section.settings.show_sort or show_filters %}
          <a href="#" class="toggle-btn utility-bar__item{% if section.settings.collapse_tag_sidebar_by_default == false %} toggle-btn--revealed-desktop{% endif %}{% if show_filters == false %} mobile-only{% endif %}" data-toggle-filters>
            <span class="btn-icon">{% render 'icon-filter' %}</span>
            <span>{{ 'products.filtering.filter' | t }}</span>
            {% liquid
              assign filter_count = 0
              for filter in collection.filters
                assign filter_count = filter_count | plus: filter.active_values.size
                if filter.type == 'price_range'
                  if filter.min_value.value != nil or filter.max_value.value != nil
                    assign filter_count = filter_count | plus: 1
                  endif
                endif
              endfor
            %}
            {% if filter_count > 0 %}
              <span class="toggle-btn__count">({{ filter_count }})</span>
            {% endif %}
            <span class="toggle-btn__chevron has-motion has-ltr-icon">{% render 'icon-chevron-right', stroke_width: 1.3 %}</span>
          </a>
        {% endif %}
      </div>

      {% if section.settings.show_total and paginate.items > 0 %}
        <div class="utility-bar__centre">
          <div class="utility-bar__item">{{ 'sections.collection.product_count' | t: count: paginate.items }}</div>
        </div>
      {% endif %}

      <div class="utility-bar__right">
        {% if section.settings.show_sort %}
          <span class="utility-bar__item desktop-only">
            <link-dropdown class="link-dropdown link-dropdown--right-aligned">
              <div class="visually-hidden" id="sort-dropdown-heading">{{ 'products.sorting.sort_by_label' | t | escape }}</div>
              <button class="link-dropdown__button has-motion" aria-expanded="false" aria-controls="sort-dropdown-options" aria-describedby="sort-dropdown-heading">
                <span class="link-dropdown__button-text">
                  {%- for option in collection.sort_options -%}
                    {%- if current_sort == option.value -%}
                      {{ option.name | escape }}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                </span>
                <span class="link-dropdown__button-icon has-motion">{% render 'icon-chevron-down', stroke_width: 1.3 %}</span>
              </button>
              <div class="link-dropdown__options" id="sort-dropdown-options">
                {%- for option in collection.sort_options -%}
                  {%- liquid
                    if section.settings.sort_show_featured == false and option.value == 'manual' and collection.default_sort_by != 'manual'
                      continue
                    endif
                    if section.settings.sort_show_best == false and option.value == 'best-selling' and collection.default_sort_by != 'best-selling'
                      continue
                    endif
                    if section.settings.sort_show_alpha == false and option.value == 'title-ascending' and collection.default_sort_by != 'title-ascending'
                      continue
                    endif
                    if section.settings.sort_show_alpha == false and option.value == 'title-descending' and collection.default_sort_by != 'title-descending'
                      continue
                    endif
                    if section.settings.sort_show_price == false and option.value == 'price-ascending' and collection.default_sort_by != 'price-ascending'
                      continue
                    endif
                    if section.settings.sort_show_price == false and option.value == 'price-descending' and collection.default_sort_by != 'price-descending'
                      continue
                    endif
                    if section.settings.sort_show_date == false and option.value == 'created-ascending' and collection.default_sort_by != 'created-ascending'
                      continue
                    endif
                    if section.settings.sort_show_date == false and option.value == 'created-descending' and collection.default_sort_by != 'created-descending'
                      continue
                    endif
                  -%}
                  <a href="{{ request.path | sort_by: option.value | escape }}" class="link-dropdown__link{% if current_sort == option.value %} link-dropdown__link--active{% endif %}">{{ option.name | escape }}</a>
                {%- endfor -%}
              </div>
            </link-dropdown>
          </span>
        {% endif %}
        <span class="utility-bar__item mobile-only">
          <div class="layout-switchers">
            <a class="layout-switch layout-switch--two-columns{% if settings.prod_thumb_mob_per_row == '2' %} layout-switch--active{% endif %}" href="#" aria-label="{{ 'sections.collection.grid_layout' | t }}">{%- render 'icon-grid', stroke_width: 1.3 -%}</a>
            <a class="layout-switch layout-switch--one-column{% if settings.prod_thumb_mob_per_row == '1' %} layout-switch--active{% endif %}" href="#" aria-label="{{ 'sections.collection.list_layout' | t }}">{%- render 'icon-box', stroke_width: 1.3 -%}</a>
          </div>
        </span>
      </div>
    </div>

    {% comment %} ---START--- Edited by: Biswajit | Date: 25/8/2024 | Reason: add size slider {% endcomment %}
    {% if section.settings.enable_size_scroll_filter == true %}
      {% comment %} {% if collection.all_products_count > 5000 %} Added by: Biswajit | Date: 3/8/2025 | Reason: hide size slider if more than 5k active product {% endcomment %}
        {%- assign ex_collections = section.settings.size_scroll_exclude_collections | map: 'handle' -%}
        {% unless ex_collections contains collection.handle %}
          {% assign size_filter = collection.filters | where: 'param_name', "filter.v.option.size" %}
          <style>
            .size-slider{
              display: flex;
              flex-wrap: nowrap;
              align-items: center;
              justify-content: center;
              gap: 12px;
              overflow-x: auto;
              margin: 25px 0;
            }
            @media (max-width:768px){
              .size-slider{
                justify-content: flex-start;
              }
            }
            .size-slider::-webkit-scrollbar {width: 0px;}
            .size-slider>a{
              display:inline-block;
              padding:5px 15px;
              border:thin solid #dbd6d6;
              border-radius:12px;
              cursor: pointer;
              text-decoration:none;
              color:black;
              flex:none;
              order:2;
            }
            .size-slider>a.active{
              background:#0000000d;
              border-color:#0000000d;
              padding-right:30px;
              position:relative;
              overflow: hidden;
              {% if section.settings.size_scroll_active_filter_first == true %}
              order:1;
              {% endif %}
            }
            .size-slider>a>span{
              display:none;
              position:absolute;
              right:0;
              top:0;
              bottom:0;
              width:20px;
              background:#0000000d;
            }
            .size-slider>a>span>svg{
              width:20px;
              height:20px;
              color:#888;
              position: absolute;
              top: 50%;
              transform: translateY(-50%);
              left: 0;
            }
            .size-slider>a.active>span{display:inline;}
            .size-slider>a.active:hover,.size-slider>a:hover{border-color:rgb(165, 165, 165);}
          </style>
          
          {% assign meta_size_count = collection.metafields.custom.sizes.value | size %}            
          {% if size_filter.size > 0 or meta_size_count > 0 %}
            {% assign size_filter = size_filter.first.values %}
            <div class="container">
              <div class="size-slider">
              {% if size_filter.size > 0 %}
                {% for value in size_filter %}
                  <a {% if value.active == true %}class="active"{% endif %} href="#" data-size-slider="{{ value.label }}" onclick='return toggleSize(this,"{{ value.label | downcase }}")'>
                    {{ value.label }}
                    <span {% if value.active == true %}class="show"{% endif %}>
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" class="icon feather feather-x" aria-hidden="true" focusable="false" role="presentation"><path d="M18 6 6 18M6 6l12 12"></path></svg>
                    </span>
                  </a>
                {% endfor %}
              {% elsif meta_size_count > 0 %}

                {% comment %} Edited by: Hasan | Date: 12/2/2024 | Reason: Showing Sizes for Large collections {% endcomment %}
                {% liquid
                  assign sizeParam = content_for_header | split: '"pageurl":"' | last | split: '"' | first
                  if sizeParam contains "filter.v.option.size=" 
                    assign sizeParam = sizeParam | split: 'filter.v.option.size=' | last | split: '\u0026' | first | downcase  
                  else
                    assign sizeParam = ""
                  endif
                %}
                                  
                {% for value in collection.metafields.custom.sizes.value %}
                  {% assign value_low = value | downcase %}
                  <a {% if sizeParam == value_low %}class="active"{% endif %} href="#" onclick="return toggleSize('{{ value_low }}','{{ sizeParam }}')">
                    {{ value }}
                    <span {% if sizeParam == value_low %}class="show"{% endif %}>
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" class="icon feather feather-x" aria-hidden="true" focusable="false" role="presentation"><path d="M18 6 6 18M6 6l12 12"></path></svg>
                    </span>
                  </a>
                {% endfor %}
              {% endif %}
              </div>
            </div>

            {% if meta_size_count > 0 %}
              {% comment %} Edited by: Hasan | Date: 12/2/2024 | Reason: Showing Sizes for Large collections {% endcomment %}
            <script>
              function toggleSize(size,param){
                if(size == param){
                  window.location.href = '{{ collection.url }}';
                }else{
                  window.location.href = '{{ collection.url }}?filter.v.option.size='+size;
                }
                return false;
              }

              var oldCount = 0;

              document.addEventListener('DOMContentLoaded', function() {
                var observer = new WebKitMutationObserver(function(mutations) {
                    mutations.forEach(function(mutation) {
                      if(document.querySelectorAll('.product-grid.product-grid--per-row-4 product-block').length > oldCount){
                        oldCount = document.querySelectorAll('.product-grid.product-grid--per-row-4 product-block').length;
                      }else if(document.querySelectorAll('.product-grid.product-grid--per-row-4 product-block').length == oldCount){
                        // document.querySelector('.pagination__next').click();
                      }
                    });    
                });
                observer.observe(document.querySelector('.product-grid.product-grid--per-row-4'), { attributes: false, childList: true, characterData: false, subtree: false });
              },false);
            </script>
            {% elsif size_filter.size > 0 %}
            <script>
              function toggleSize(tag,filter){
                document.querySelector('.filter-group__item[data-tag="'+filter+'"]').click()
                document.querySelector('.size-slider').scrollTo(0,0);
                return false;
              }

              function addSizeFilterListener(){
                document.querySelectorAll('input.filter-group__checkbox[name="filter.v.option.size"]').forEach(function(item){
                    if(item.checked){
                      document.querySelector('a[data-size-slider="'+item.value+'"]').className="active";
                    }else{
                      document.querySelector('a[data-size-slider="'+item.value+'"]').className="";
                    }
                    item.addEventListener('change', function() {
                      if(this.checked){
                        document.querySelector('a[data-size-slider="'+this.value+'"]').className="active";
                      }else{
                        document.querySelector('a[data-size-slider="'+this.value+'"]').className="";
                      }
                    },false);
                })
                document.querySelector('.size-slider').scrollTo(0,0);
                document.querySelectorAll("carousel-slider a.image-overlay__image-link").forEach(function(item){
                  item.href = item.href.split("?")[0] + window.location.search;
                })
              }

              document.addEventListener('DOMContentLoaded', function() {
                addSizeFilterListener();
                var observer = new WebKitMutationObserver(function(mutations) {
                    mutations.forEach(function(mutation) {
                      addSizeFilterListener();
                    });    
                });
                observer.observe(document.querySelector('.filters__inner.sticky-content-container'), { attributes: false, childList: true, characterData: false, subtree: false });
              },false);
            </script>
            {% endif %}
            
          {% endif %}
        {% endunless %}
      {% comment %} {% endif %} {% endcomment %}
    {% endif %}
    {% comment %} ---END--- Edited by: Biswajit | Date: 25/8/2024 | Reason: add size slider {% endcomment %}
    
  {% comment %} ---START--- Edited by: Hasan | Date 12/10/2025 | Reason: Custom bilingual buttons from metafield --- {% endcomment %}
    {% assign current_locale = localization.language.iso_code | downcase %}

    {% if current_locale contains 'ar' %}
      {% assign links = collection.metafields.custom.customlinks_ar.value %}
    {% else %}
      {% assign links = collection.metafields.custom.customlinks_en.value %}
    {% endif %}

    {% if links and links.size > 0 %}
      <style>
        .custom-links-bar {
          display: flex;
          flex-wrap: nowrap;
          align-items: center;
          justify-content: center;
          gap: 12px;
          overflow-x: auto;
          margin: 25px 0;
          direction: {% if current_locale contains 'ar' %}rtl{% else %}ltr{% endif %};
        }
        .custom-links-bar::-webkit-scrollbar { width: 0; height: 0; }
        .custom-links-bar a {
          display: inline-block;
          padding: 6px 16px;
          border: 1px solid #dbd6d6;
          border-radius: 12px;
          text-decoration: none;
          color: #fdf8fa;
          background-color: #c16452;
          white-space: nowrap;
          transition: all 0.2s ease-in-out;
          flex: none;
        }
        .custom-links-bar a:hover {
          border-color: #999;
          background-color:rgb(167, 167, 167);
        }
        @media (max-width: 768px) {
          .custom-links-bar { justify-content: flex-start; }
        }
      </style>

      <div class="container">
        <div class="custom-links-bar">
          {% for item in links %}
            {% assign parts = item | split: '|' %}
            <a href="{{ parts[0] | strip }}">{{ parts[1] | default: parts[0] | strip }}</a>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  {% comment %} ---END--- Edited by: Hasan | Date 12/10/2025 | Reason: Custom bilingual buttons from metafield --- {% endcomment %}

    <filter-container class="filter-container filter-container--side{% if section.settings.collapse_tag_sidebar_by_default == false %} filter-container--show-filters-desktop{% endif %}" data-ajax-filtering="{{ settings.ajax_products }}" data-filter-section-id="{{ section.id }}">
      {% if section.settings.show_sort or show_filters %}
        {% render 'faceted-filters', filter_context: collection, clear_url: collection.url, current_sort: current_sort %}
      {% endif %}

      <div class="filters-adjacent collection-listing" data-ajax-container>
        {% if collection.products.size == 0 %}
          <h5 class="align-centre fully-spaced-row">{{ 'sections.collection.empty' | t }}</h5>
        {% else %}
          <div class="product-grid product-grid--per-row-{{ section.settings.grid }} product-grid--per-row-mob-{{ settings.prod_thumb_mob_per_row }} product-grid--per-row-mob-{{ settings.prod_thumb_mob_per_row }}">
            {%- liquid
              if settings.prod_thumb_shape == 'portrait-23'
                assign chosen_aspect_ratio = 0.67
              elsif settings.prod_thumb_shape == 'portrait-45'
                assign chosen_aspect_ratio = 0.8
              elsif settings.prod_thumb_shape == 'square'
                assign chosen_aspect_ratio = 1.0
              elsif settings.prod_thumb_shape == 'landscape-54'
                assign chosen_aspect_ratio = 1.25
              elsif settings.prod_thumb_shape == 'landscape-32'
                assign chosen_aspect_ratio = 1.50
              elsif settings.prod_thumb_shape == 'tallest'
                assign chosen_aspect_ratio = 99
                for product in collection.products
                  if product.featured_media.preview_image.aspect_ratio < chosen_aspect_ratio
                    assign chosen_aspect_ratio = product.featured_media.preview_image.aspect_ratio
                  endif
                endfor
              else
                assign chosen_aspect_ratio = 0
                for product in collection.products
                  if product.featured_media.preview_image.aspect_ratio > chosen_aspect_ratio
                    assign chosen_aspect_ratio = product.featured_media.preview_image.aspect_ratio
                  endif
                endfor
              endif

              assign product_count = 0
               
              for product in collection.products
                assign prioritised_loading = false
                if forloop.index0 < section.settings.grid
                  assign prioritised_loading = true
                endif

                comment
                  Edited by: Biswajit | Date: 02/12/2024 | Reason: add if statement for custom size filter
                endcomment
            
                if collection.filters == empty and sizeParam != "" and meta_size_count > 0
                  assign product_sizes = product.options_by_name["size"].values | join: ',' | downcase | split: ','
                  if product_sizes contains sizeParam
                    assign product_count = product_count | plus: 1
                    render 'product-block', product: product, custom_aspect_ratio: chosen_aspect_ratio, animate: true, prioritised_loading: prioritised_loading
                  endif
                else
                  render 'product-block', product: product, custom_aspect_ratio: chosen_aspect_ratio, animate: true, prioritised_loading: prioritised_loading
                endif
          
                
              endfor

              if collection.filters == empty and sizeParam != "" and meta_size_count > 0 and product_count == 0
                  render 'product-block', product: collection.products.first, custom_aspect_ratio: chosen_aspect_ratio, animate: true, prioritised_loading: prioritised_loading
                  render 'product-block', product: collection.products.last, custom_aspect_ratio: chosen_aspect_ratio, animate: true, prioritised_loading: prioritised_loading
              endif
            -%}
          </div>
        {% endif %}
      </div>
    </filter-container>
  </div>

  <div class="container pagination-row" data-ajax-container>{% render 'pagination-control', paginate: paginate %}</div>

  {% endpaginate %}

  {% comment %} ---START--- Edited by: Biswajit | Date: 5/9/2024 | Reason: add scroll animation and auto page load {% endcomment %}
  {% if section.settings.pagination_type == 'circle' %}
    <style>
      .progress-circle circle.progress {
        transform: rotate(-90deg);
        transform-origin: 50% 50%;
      }
      .circle-pagination{
        display:none;
        justify-content: center;
        flex-wrap: nowrap;
        gap:10px;
      }
      .circle-pagination.active{display:flex; margin-top:50px;}
      .circle-pagination img{
        object-fit:contain;
        cursor:pointer;
      }
    </style>
    
    <div class="circle-pagination">
      <img src="{{ 'pagination_prev.png' | asset_url }}" width="50px" height="50px" onclick="document.querySelector('.pagination__prev').click()">
    
      <svg class="progress-circle" width="100" height="100">
          <circle class="circle-background" stroke="#e5e2d7" stroke-width="6" fill="transparent" r="40" cx="50" cy="50"></circle>
          <circle class="progress" stroke="{{ section.settings.circle_color }}" stroke-width="6" fill="transparent" r="40" cx="50" cy="50"></circle>
          <circle class="handle" stroke="#fff" stroke-width="6" fill="{{ section.settings.circle_color }}" r="10" cx="50" cy="50"></circle>
          <text x="50" y="50" font-size="12" font-weight="bold" fill="{{ section.settings.circle_color }}" text-anchor="middle" alignment-baseline="central">Page 1</text>
      </svg>
            
      <img src="{{ 'pagination_next.png' | asset_url }}" width="50px" height="50px" onclick="document.querySelector('.pagination__next').click()">
    </div>
    
    <script>
      
      var circle = document.querySelector('.circle-pagination circle.progress');
      var radius = circle.r.baseVal.value;
      var circumference = radius * 2 * Math.PI;
      var originX = circle.cx.baseVal.value;
      var originY = circle.cy.baseVal.value;
      var handle = document.querySelector('.circle-pagination circle.handle');
      var auto_loading = false;
      
      circle.style.strokeDasharray = `${circumference} ${circumference}`;
      circle.style.strokeDashoffset = `${circumference}`;
      
      function setProgress(percent) {
        var reverse_percent = 100 - percent;
        const offset = reverse_percent / 100 * circumference;
        circle.style.strokeDashoffset = -1 * offset;
        setHandleRotation(percent);
      }
       
      function setHandleRotation(percent) {
        var angle = (180 + (percent*3.6) ) % 360;
        var angle_radians = angle * Math.PI / 180;
        var xOffset = radius * ( Math.sin( angle_radians ) );
        var yOffset = radius * ( Math.cos( angle_radians ) );
        var x = originX + xOffset;
        var y = originY + yOffset;
        handle.attributes.cx.value = x;
        handle.attributes.cy.value = y; 
    
        if(percent == 100 && auto_loading == false){
          auto_loading = true;
          document.querySelector('.pagination__next').click();
        }
        if(percent < 10 ){
          auto_loading = false;
          document.querySelector('.progress-circle>text').innerHTML = "Page " + document.querySelector('.underline--not-link').innerText;
        }
      }
      
      window.addEventListener('scroll', function(e) {
        var circle_position = document.querySelector('.circle-pagination').getBoundingClientRect().top - window.innerHeight;
        if(circle_position < 0){
          setProgress(Math.min(100, Math.abs(circle_position)/3))
        }
      })
  
      document.addEventListener('DOMContentLoaded', function() {
        if(document.querySelector('.pagination') != null) document.querySelector('.circle-pagination').classList.add('active')
      })
    </script>
  {% endif %}
  {% comment %} ---END--- Edited by: Biswajit | Date: 5/9/2024 | Reason: add scroll animation and auto page load {% endcomment %}


  {% if collection.description != blank and section.settings.coll_desc_pos == 'below' %}
    <div class="container container--reading-width fully-spaced-row" {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
      <div class="rte cf">{{ collection.description }}</div>
    </div>
  {% endif %}
</div>


