{% comment %} Created by: Biswajit | Date: 3/9/2024 | Reason: display recently viewed products {% endcomment %}
{% if template.name == 'product' %}
<style>
  .recent-products{display:none}
  .recent-products.active{display:block}
  .rvp_cont{
    display: grid;
    overflow-x: scroll;
    overflow-y: hidden;
    grid-gap: 25px;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (4 * 25px)) / 5);
    font-size:14px;
    padding-bottom:0;
    scrollbar-width:none;
    scroll-behavior:smooth;
    scroll-snap-type: x mandatory;
    position:relative;
  }
  .rvp_cont a{
    color:#5C5C5C !important;
    scroll-snap-align: start;
  }
  .rvp_cont img{
    width:100%;
    display:block;
  }
  .rvp_cont p{
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    margin-top: 10px;
    margin-bottom: 0px;
  }
  .rvp_cont span{
    display:inline-block;
    margin-inline-end:.5rem;
  }
  .rvp_cont span#cprice{
    opacity:0.5;
  }
  .recent-products .rvp_left,
  .recent-products .rvp_right{
    position:absolute;
    z-index:2;
    top: 50%;
    padding:5px;
    border-radius: 100%;
    background-color:white;
    box-shadow: 0px 0px 5px rgba(0, 0, 0, .2);
    visibility: hidden;
  }
  .recent-products button.active{visibility:visible}
  .recent-products button.rvp_left{left: 15px;}
  .recent-products button.rvp_right{right: 15px;}
  @media (max-width:768px){
    .rvp_cont{
      grid-auto-columns: 38%;
    }
    .recent-products button{
      display:none !important;
    }
  }
</style>
<div class="recent-products">
  <div class="container{% if settings.use_fullwidth_layout %} container--no-max{% endif %} fully-spaced-row" style="position:relative;">
      <h4 class="align-center hometitle">{{ section.settings.rvp_title }}</h4>
      <button class="rvp_left"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" class="icon feather feather-chevron-left" aria-hidden="true" focusable="false" role="presentation"><path d="m15 18-6-6 6-6"></path></svg></button>
      <button class="rvp_right"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" class="icon feather feather-chevron-right" aria-hidden="true" focusable="false" role="presentation"><path d="m9 18 6-6-6-6"></path></svg></button>
      <div class="rvp_cont">
      </div>
  </div>
</div>

<script>
  var viewedProducts = getRecentlyViewedProducts();
  var availableProducts = getRecentlyViewedProducts();
  viewedProducts.splice(0, 1);
  if(viewedProducts.length > 0) document.querySelector('.recent-products').classList.add('active')
  var rvp_cont = document.querySelector('.rvp_cont');
  viewedProducts.forEach((product)=>{
    var product_html = document.createElement('a');
    product_html.setAttribute("data-rvp-handle", product)
    product_html.innerHTML = '<img src="" data-src=""><p></p><span id="price"></span> <span id="cprice" style="text-decoration: line-through;"></span>';
    rvp_cont.appendChild(product_html);
    fetch(window.Shopify.routes.root + 'products/' + product + '.js')
    .then((response) => {
      if (!response.ok) {
        product_html.style.display = "none";
        availableProducts.splice(availableProducts.indexOf(product),1);
        localStorage.setItem('recently_viewed_products', JSON.stringify(availableProducts));
      }
      return response.json();
    }).then(product => {
      document.querySelector('[data-rvp-handle="'+product.handle+'"]').href = product.url;
      document.querySelector('[data-rvp-handle="'+product.handle+'"] img').dataset.src = product.featured_image + "&width=340";
      document.querySelector('[data-rvp-handle="'+product.handle+'"] p').innerText = product.title;
      document.querySelector('[data-rvp-handle="'+product.handle+'"] #price').innerText = (product.price/100).toFixed(3).replace('.',',') + ' ' + window.Shopify.currency.active;
      document.querySelector('[data-rvp-handle="'+product.handle+'"] #cprice').innerText = product.compare_at_price>0?(product.compare_at_price/100).toFixed(3).replace('.',',') + ' ' + window.Shopify.currency.active:'';
    });
  })

  function loadRVPimages(){
    document.querySelectorAll('[data-rvp-handle]>img').forEach(function(img) {
          if (img.hasAttribute('data-src') && img.getBoundingClientRect().top < window.scrollY + window.innerHeight + 10) {
              var source = img.dataset.src;
              img.setAttribute('src', source);
              img.removeAttribute('data-src');
          }
      })
  }
  
  document.querySelector('.rvp_right').addEventListener('click', function() {
    skip = false;
    document.querySelectorAll('.rvp_cont a').forEach((e)=>{
        if(e.parentNode.offsetWidth < e.offsetLeft - e.parentNode.scrollLeft){
          if(skip == false){
            e.scrollIntoView({block: "nearest", inline: "nearest"});
            skip=true;
          }
        }
    })
  })
  document.querySelector('.rvp_left').addEventListener('click', function() {
    skip = false;
    elements = document.querySelectorAll('.rvp_cont a');
    elements = [...elements];
    elements.reverse().forEach((e)=>{
        if(e.offsetLeft - e.parentNode.scrollLeft < 0){
          if(skip == false){
            e.scrollIntoView({block: "nearest", inline: "nearest"});
            skip=true;
          }
        }
    })
  })
  document.querySelector('.rvp_cont').addEventListener('scroll', function() {
    checkRVPScrollBtn(this)
    loadRVPimages();
  })
  function checkRVPScrollBtn($this){
    if($this.scrollLeft == 0) document.querySelector('.rvp_left').classList.remove('active')
    else document.querySelector('.rvp_left').classList.add('active')
    if($this.scrollLeft == ($this.scrollWidth - $this.offsetWidth)) document.querySelector('.rvp_right').classList.remove('active')
    else document.querySelector('.rvp_right').classList.add('active')
  }
  checkRVPScrollBtn(document.querySelector('.rvp_cont'))

  window.addEventListener("scroll", function() {
      loadRVPimages();
  })

  
</script>

{% endif %}

{% schema %}
  {
    "name": "Recently Viewed Products",
    "settings": [
      {
        "type": "paragraph",
        "content": "Show the recently viewed products stored in the user's browser"
      },
      {
        "type": "paragraph",
        "content": "NOTE: For product page only"
      },
      {
        "type": "text",
        "id": "rvp_title",
        "label": "Heading"
      },
      {
        "type": "range",
        "id": "rvp_product_count",
        "min": 4,
        "max": 20,
        "step": 1,
        "label": "Products to display",
        "default": 5
      }
    ],
    "presets": [
      {
        "name": "Recently Viewed Products",
        "settings": {
        }
      }
    ]
  }
{% endschema %}