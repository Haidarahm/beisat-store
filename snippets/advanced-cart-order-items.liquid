<section class="card" aria-labelledby="order-items-title">
  <div class="card__header">
    <h2 id="order-items-title" class="card__title">
      {{ 'cart.advanced.order_items' | t }}{% unless cart.empty? %} ({{ cart.item_count }}){% endunless %}
    </h2>
  </div>
  <p class="card__subtitle">
    {%- if cart.empty? -%}
      {{ 'cart.advanced.empty_cart' | t }}
    {%- else -%}
      {{ 'cart.advanced.items_in_cart' | t }}
    {%- endif -%}
  </p>
  <hr class="card__divider" />

  <div class="order-items" id="order-items-list">
    {%- if cart.empty? -%}
      <p class="order-items__empty">{{ 'cart.advanced.empty_hint' | t }}</p>
    {%- else -%}
      {%- for item in cart.items -%}
        <article class="order-item">
          <div class="order-item__media">
            {%- if item.image -%}
              <img
                class="order-item__thumb"
                src="{{ item.image | image_url: width: 144 }}"
                alt="{{ item.image.alt | default: item.product.title | escape }}"
                width="72"
                height="72"
                loading="lazy"
              >
            {%- else -%}
              <span class="order-item__thumb order-item__thumb--placeholder" aria-hidden="true"></span>
            {%- endif -%}
            <span class="order-item__badges">
              <span class="order-item__qty">×{{ item.quantity }}</span>
            </span>
          </div>
          <p class="order-item__price">{{ item.final_line_price | money }}</p>
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>
