      </div>
      <div style="min-width:0; overflow:hidden;">
        <div style="font-size:13px; font-weight:500; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
          {{ 'custom_liquid.install_app_banner_title' | t }}
        </div>
        <div style="font-size:12px; color:#757575; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
          {{ 'custom_liquid.install_app_banner_description' | t }}
        </div>
      </div>
    </div>

    <div style="display:flex; align-items:center; gap:10px; flex-shrink:0;">
      <button id="app-banner-open-btn" style="
        background:#0d0d0d;
        color:#ffffff;
        border:none;
        border-radius:20px;
        padding:7px 18px;
        font-size:13px;
        font-weight:700;
        cursor:pointer;
        white-space:nowrap;
      ">{{ 'custom_liquid.install_app_banner_open' | t }}</button>
      <button id="app-banner-close-btn" aria-label="Close" style="
        background:transparent;
        border:none;
        color:#0d0d0d;
        font-size:20px;
        line-height:1;
        cursor:pointer;
        padding:0 2px;
      ">&times;</button>
    </div>
  </div>
{% endunless %}

<script>
(function() {
  var banner = document.getElementById('app-install-banner');
  var openBtn = document.getElementById('app-banner-open-btn');
  var closeBtn = document.getElementById('app-banner-close-btn');
  var storageKey = 'app_install_banner_dismissed';
  var iosUrl = {{ ios_app_url | json }};
  var androidUrl = {{ android_app_url | json }};

  function isDismissed() {
    try {
      var until = localStorage.getItem(storageKey);
      return until && Date.now() < parseInt(until, 10);
    } catch (e) {
      return false;
    }
  }

  function isMobile() {
    return /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
  }

function isInApp() {
  return navigator.userAgent.indexOf('BEISAT_ANDROID') !== -1 ||
         navigator.userAgent.indexOf('BEISAT_IOS') !== -1;
}

  if (banner && isMobile() && !isInApp() && !isDismissed()) {
    banner.style.display = 'flex';
  }

  if (openBtn) {
    openBtn.addEventListener('click', function() {
      var isIOS = /iPhone|iPad|iPod/i.test(navigator.userAgent);
      window.location.href = isIOS ? iosUrl : androidUrl;

      banner.style.display = 'none';
      try {
        var oneDay = Date.now() + 24 * 60 * 60 * 1000;
        localStorage.setItem(storageKey, oneDay.toString());
      } catch (e) {}
    });
  }

  if (closeBtn) {
    closeBtn.addEventListener('click', function() {
      banner.style.display = 'none';
      try {
        var sevenDays = Date.now() + 7 * 24 * 60 * 60 * 1000;
        localStorage.setItem(storageKey, sevenDays.toString());
      } catch (e) {}
    });
  }
})();
</script>