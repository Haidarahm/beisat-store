<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>
  {%- if request.page_type == 'password' -%}
    {{- shop.name -}}
  {%- comment -%} ---START--- Edited by: Hasan | Date: 26/4/2026 | Reason: SEO meta Tags edit {%- endcomment -%}
  {%- elsif template contains 'product' -%}
      {%- if localization.language.iso_code == 'ar' -%}
        {{- product.title | truncate: 50 | split: '.' | first | split: ',' | first | split: ';' | first | strip | append: ' - عُمان' -}}
      {%- else -%}
        {{- product.title | truncate: 50 | split: '.' | first | split: ',' | first | split: ';' | first | strip | append: ' - Oman' -}}
      {%- endif -%}
  {%- elsif template contains 'collection' -%}
    {%- if localization.language.iso_code == 'ar' -%}
      {{- collection.title | append: ' - شي إن عمان | بيسات' -}}
    {%- else -%}
      {{- collection.title | append: ' - Shein Outlet | Beisat' -}}
    {%- endif -%}
  {%- comment -%} ---END--- Edited by: Hasan | Date: 26/4/2026 | Reason: SEO meta Tags edit {%- endcomment -%}
  {%- else -%}
    {{- page_title -}}
    {%- if current_tags %}{% assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags }}{% endif -%}
    {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  {%- endif -%}
</title>

{%- if canonical_url != blank -%}
  <link rel="canonical" href="{{ canonical_url }}">
{%- endif -%}

{%- if settings.favicon != blank -%}
  {%- liquid
    assign image_type = settings.favicon | split: '?' | first | split: '.' | last | downcase
    if image_type == 'svg'
      assign image_type = 'svg+xml'
    endif
  -%}
  <link rel="icon" href="{{ settings.favicon | image_url: width: 48, height: 48 }}" type="image/{{ image_type }}">
  <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
{%- endif -%}

{% comment %} ---START--- Edited by: Hasan | Date: 26/4/2026 | Reason: SEO meta Tags edit {% endcomment %}
{%- if template contains 'product' -%}
  {%- if localization.language.iso_code == 'ar' -%}
    <meta name="description" content="احصل على {{ product.title | truncate: 50 | split: '.' | first | split: ',' | first | split: ';' | first | strip }} الآن من بيسات. شحن سريع ابتداءاً من  {{ product.price | money | strip_html }}">
  {%- else -%}
    <meta name="description" content="Get the {{ product.title | truncate: 50 | split: '.' | first | split: ',' | first | split: ';' | first | strip }} at Beisat Oman. Fast delivery. Starting at {{ product.price | money | strip_html }}">
  {%- endif -%}
{%- elsif template contains 'collection' -%}
    {%- if localization.language.iso_code == 'ar' -%}
      <meta name="description" content="اكتشف {{ collection.title }}  من بيسات عمان. توصيل سريع وأفضل الأسعار. اكتشف المجموعة">
    {%- else -%}
    <meta name="description" content="Shop the latest {{ collection.title }} at Beisat Oman. Fast local delivery & Lowest prices">
    {%- endif -%}
{%- elsif page_description -%}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif -%}
{% comment %} ---END--- Edited by: Hasan | Date: 26/4/2026 | Reason: SEO meta Tags edit {% endcomment %}
