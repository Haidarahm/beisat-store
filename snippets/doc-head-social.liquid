{% comment %} ---START--- Edited by: Biswajit | Date: 28/8/2024 | Reason: add click animation to all clickable item {% endcomment %}
<link rel="stylesheet" href="{{ 'animate.min.css' | asset_url }}"/>
<script>
  function listenToClicks(){
    document.querySelectorAll('a,button').forEach(function(item){
        item.addEventListener('click', function() {
          item.classList.remove('animate__animated')
          item.classList.remove('animate__fast')
          item.classList.remove('animate__pulse')
          item.classList.add('animate__animated')
          item.classList.add('animate__fast')
          item.classList.add('animate__pulse')
          setTimeout(function(){
            item.classList.remove('animate__animated')
            item.classList.remove('animate__fast')
            item.classList.remove('animate__pulse')
          },800);
        },false);
    })
  }
  
  document.addEventListener('DOMContentLoaded', function() {
    listenToClicks();

    ['.collection-listing .product-grid', '.related-products'].forEach(function(selector) {
      if(document.querySelector(selector)){
        new WebKitMutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
              listenToClicks();
            });    
        }).observe(document.querySelector(selector), { attributes: false, childList: true, characterData: false, subtree: false });
      }
    });
  });
</script>
{% comment %} ---END--- Edited by: Biswajit | Date: 28/8/2024 | Reason: add click animation to all clickable item {% endcomment %}

{% comment %} ---START--- Edited by: Biswajit | Date: 4/9/2024 | Reason: remember and redirect the user to previously clicked collection {% endcomment %}
{% if template.name == 'index' %}
<script>
  var fav_coll_lang = "_{{ localization.language.iso_code }}";
  if(localStorage.getItem('fav_collection_page'+fav_coll_lang) != null) window.location.href = localStorage.getItem('fav_collection_page'+fav_coll_lang);
  document.addEventListener('DOMContentLoaded', function() {
    var home_collection_links = document.querySelectorAll('.home_collection_links');
    if (home_collection_links.length > 0){
      home_collection_links.forEach((e)=>{
        e.addEventListener('click', function() {
          localStorage.setItem('fav_collection_page'+fav_coll_lang,e.href);
        });
      })
    }
  });
</script>
{% elsif template.name == 'page' %}
<script>
  console.log("{{ page.handle }}")
  var fav_coll_lang = "_{{ localization.language.iso_code }}";
  var fav_collection_par_arr = ['men','women','kids','house',"الرجال","نساء","الأطفال","منزل"];
  if(fav_collection_par_arr.includes("{{ page.handle }}")) localStorage.setItem('fav_collection_page'+fav_coll_lang,"{{page.url}}")
</script>
{% endif %}
{% comment %} ---END--- Edited by: Biswajit | Date: 4/9/2024 | Reason: remember and redirect the user to previously clicked collection {% endcomment %}

{% comment %} ---START--- Edited by: Biswajit | Date: 10/10/2024 | Reason: disable footer and mobile app banner on app {% endcomment %}
<script>
  if(navigator.userAgent.includes("BEISAT_ANDROID_V2") || navigator.userAgent.includes("BEISAT_IOS_V2")){
    const style = document.createElement("style")
    style.textContent = ".smartbanner,.section-footer,.cross-page-promos { display:none !important; } #pagefooter{padding:50px;}"
    document.head.appendChild(style)
  }
</script>
