<script>
  var initialHeight = window.visualViewport.height;
  window.visualViewport.addEventListener("resize", (e) => {
    if(window.visualViewport.height < initialHeight){
      document.querySelector('.sticky-section').className = 'sticky-section hidden';
    }else{
      document.querySelector('.sticky-section').className = 'sticky-section';
    }
  })
</script>
