        "code": "<script>\n(function () {\n  function openCustomerAccount() {\n    if (document.body.classList.contains('template-cart') === false) return;\n\n    const account = document.querySelector('shopify-account');\n\n    if (!account || !account.shadowRoot) return;\n\n    const loginButton = account.shadowRoot.querySelector(\n      '[part=\"signed-out-avatar\"]'\n    );\n\n    if (!loginButton) return;\n\n    loginButton.click();\n  }\n\n  const observer = new MutationObserver(function () {\n    const account = document.querySelector('shopify-account');\n\n    if (account && account.shadowRoot) {\n      const loginButton = account.shadowRoot.querySelector(\n        '[part=\"signed-out-avatar\"]'\n      );\n\n      if (loginButton) {\n        observer.disconnect();\n\n        setTimeout(openCustomerAccount, 300);\n      }\n    }\n  });\n\n  observer.observe(document.documentElement, {\n    childList: true,\n    subtree: true\n  });\n\n  setTimeout(openCustomerAccount, 500);\n})();\n</script>\n\n<pre style=\"font:12px monospace;background:#eee;padding:8px\">\ncustomer.first_name       = [{{ customer.first_name }}]\ncustomer.last_name        = [{{ customer.last_name }}]\ncustomer.name             = [{{ customer.name }}]\ncustomer.email            = [{{ customer.email }}]\ncustomer.phone            = [{{ customer.phone }}]\ndefault_address.first_name= [{{ customer.default_address.first_name }}]\n</pre>"
