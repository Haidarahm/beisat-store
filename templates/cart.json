      "settings": {
        "full_width": false,
        "show_space": false,
        "code": "{% comment %}\n  DEMO ONLY — simulated GPS capture.\n  No real geolocation is requested. Coordinates and address are hardcoded\n  to Ghala, Muscat. Phone is real user input. The Liquid form is genuine:\n  it lives inside the manual-entry modal, and the GPS path fills the very\n  same inputs before submitting. Returns to /checkout.\n{% endcomment %}\n\n{% if customer %}\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n<div id=\"beisat-geo\" data-state=\"idle\">\n  <style>\n    #beisat-geo{\n      --green:#22A75B; --green-dk:#1B8A4A;\n      --ink:#141414; --muted:#7A7A7A; --line:#E7E7E7; --wash:#F5F7F6;\n      font-family:'Poppins',system-ui,sans-serif;\n      color:var(--ink); background:#fff;\n      border:1px solid var(--line); border-radius:12px;\n      padding:16px; max-width:520px;\n    }\n    #beisat-geo *{box-sizing:border-box}\n\n    #beisat-geo .g-head{display:flex; align-items:center; gap:8px; margin-bottom:2px}\n    #beisat-geo .g-pill{\n      background:var(--green); color:#fff; font-size:10px; font-weight:600;\n      letter-spacing:.06em; text-transform:uppercase; padding:3px 9px; border-radius:999px;\n    }\n    #beisat-geo .g-title{font-size:17px; font-weight:700; margin:0; letter-spacing:-.01em}\n    #beisat-geo .g-sub{font-size:12.5px; color:var(--muted); margin:2px 0 14px}\n\n    /* ---- scanner ---- */\n    #beisat-geo .g-scan{\n      display:flex; align-items:center; gap:14px;\n      background:var(--wash); border-radius:10px; padding:12px 14px; margin-bottom:12px;\n    }\n    #beisat-geo .g-radar{width:66px; height:66px; flex:0 0 66px}\n    #beisat-geo .ring{fill:none; stroke:#D5DDD8; stroke-width:1}\n    #beisat-geo .ring-live{fill:none; stroke:var(--green); stroke-width:1.5; opacity:0; transform-origin:50px 50px}\n    #beisat-geo[data-state=\"scanning\"] .ring-live{animation:g-ping 1.5s ease-out infinite}\n    #beisat-geo .ring-live:nth-of-type(2){animation-delay:.5s}\n    #beisat-geo .ring-live:nth-of-type(3){animation-delay:1s}\n    @keyframes g-ping{0%{transform:scale(.2); opacity:.9} 100%{transform:scale(1); opacity:0}}\n    #beisat-geo .sweep{transform-origin:50px 50px; opacity:0}\n    #beisat-geo[data-state=\"scanning\"] .sweep{opacity:1; animation:g-sweep 1.5s linear infinite}\n    @keyframes g-sweep{to{transform:rotate(360deg)}}\n    #beisat-geo .pin{opacity:0; transition:opacity .35s ease}\n    #beisat-geo[data-state=\"found\"] .pin{opacity:1}\n    #beisat-geo[data-state=\"found\"] .sweep{opacity:0}\n\n    #beisat-geo .g-meta{flex:1; min-width:0}\n    #beisat-geo .g-status{font-size:13px; font-weight:500; margin:0 0 5px; transition:opacity .2s}\n    #beisat-geo .g-status.fade{opacity:0}\n    #beisat-geo .g-nums{font-size:11px; color:var(--muted); font-variant-numeric:tabular-nums; display:flex; justify-content:space-between; gap:10px}\n    #beisat-geo .g-bar{height:3px; background:#E2E8E4; border-radius:2px; margin-top:7px; overflow:hidden}\n    #beisat-geo .g-bar i{display:block; height:100%; width:0; background:var(--green); border-radius:2px; transition:width .5s ease}\n\n    /* ---- result ---- */\n    #beisat-geo .g-result{display:none; border:1px solid var(--line); border-radius:10px; padding:12px 14px; margin-bottom:12px}\n    #beisat-geo[data-state=\"found\"] .g-result{display:block; animation:g-rise .35s ease both}\n    @keyframes g-rise{from{opacity:0; transform:translateY(6px)} to{opacity:1; transform:none}}\n    #beisat-geo .g-place{font-size:15px; font-weight:600; margin:0 0 3px}\n    #beisat-geo .g-lines{font-size:12.5px; color:var(--muted); line-height:1.5; margin:0}\n    #beisat-geo .g-ok{display:inline-block; margin-top:7px; font-size:11px; font-weight:600; color:var(--green)}\n\n    /* ---- phone ---- */\n    #beisat-geo .g-label{display:block; font-size:12px; font-weight:600; margin-bottom:6px}\n    #beisat-geo .g-phone{display:flex; border:1px solid var(--line); border-radius:8px; overflow:hidden; margin-bottom:6px}\n    #beisat-geo .g-cc{background:var(--wash); color:var(--muted); font-size:13.5px; font-weight:500; padding:11px 12px; border-right:1px solid var(--line); white-space:nowrap}\n    #beisat-geo .g-phone input{flex:1; border:0; outline:0; padding:11px 12px; min-width:0; font-family:inherit; font-size:14px; letter-spacing:.04em}\n    #beisat-geo .g-phone:focus-within{border-color:var(--green)}\n    #beisat-geo .g-err{font-size:11.5px; color:#D64545; margin:0 0 10px; display:none}\n    #beisat-geo .g-err.show{display:block}\n\n    /* ---- buttons ---- */\n    #beisat-geo .g-btn{\n      width:100%; border:0; border-radius:8px; cursor:pointer;\n      background:var(--ink); color:#fff; font-family:inherit;\n      font-weight:600; font-size:14px; letter-spacing:.03em; text-transform:uppercase;\n      padding:14px 16px;\n    }\n    #beisat-geo .g-btn:focus-visible{outline:2px solid var(--green); outline-offset:2px}\n    #beisat-geo[data-state=\"scanning\"] .g-btn{opacity:.4; pointer-events:none}\n    #beisat-geo[data-state=\"found\"] .g-btn{background:var(--green)}\n    #beisat-geo[data-state=\"found\"] .g-btn:hover{background:var(--green-dk)}\n    #beisat-geo .g-alt{\n      width:100%; margin-top:8px; background:none; border:1px solid var(--line);\n      border-radius:8px; padding:12px 16px; cursor:pointer;\n      font-family:inherit; font-size:13px; font-weight:500; color:var(--muted);\n    }\n    #beisat-geo .g-alt:hover{border-color:var(--ink); color:var(--ink)}\n    #beisat-geo .g-alt:focus-visible{outline:2px solid var(--green); outline-offset:2px}\n\n    /* ---- modal ---- */\n    #beisat-geo .g-modal{\n      position:fixed; inset:0; z-index:9999; display:none;\n      background:rgba(0,0,0,.45); align-items:flex-end; justify-content:center;\n    }\n    #beisat-geo .g-modal.open{display:flex}\n    #beisat-geo .g-sheet{\n      background:#fff; width:100%; max-width:520px; max-height:88vh; overflow-y:auto;\n      border-radius:16px 16px 0 0; padding:18px 16px 22px;\n      animation:g-up .28s ease both;\n    }\n    @keyframes g-up{from{transform:translateY(24px); opacity:0} to{transform:none; opacity:1}}\n    @media (min-width:640px){\n      #beisat-geo .g-modal{align-items:center}\n      #beisat-geo .g-sheet{border-radius:14px}\n    }\n    #beisat-geo .g-sheet-top{display:flex; align-items:center; justify-content:space-between; margin-bottom:14px}\n    #beisat-geo .g-sheet-title{font-size:16px; font-weight:700; margin:0}\n    #beisat-geo .g-x{background:none; border:0; font-size:22px; line-height:1; color:var(--muted); cursor:pointer; padding:2px 6px}\n    #beisat-geo .g-grid{display:grid; grid-template-columns:1fr 1fr; gap:10px}\n    #beisat-geo .g-grid .full{grid-column:1 / -1}\n    #beisat-geo .g-f{display:block}\n    #beisat-geo .g-f span{display:block; font-size:11.5px; font-weight:600; margin-bottom:5px}\n    #beisat-geo .g-f input, #beisat-geo .g-f select{\n      width:100%; border:1px solid var(--line); border-radius:8px;\n      padding:11px 12px; font-family:inherit; font-size:14px; outline:0; background:#fff;\n    }\n    #beisat-geo .g-f input:focus, #beisat-geo .g-f select:focus{border-color:var(--green)}\n    #beisat-geo .g-save{margin-top:14px}\n    #beisat-geo .g-hide{position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0)}\n\n    @media (prefers-reduced-motion:reduce){#beisat-geo *{animation:none !important; transition:none !important}}\n  </style>\n\n  <div class=\"g-head\">\n    <span class=\"g-pill\">Delivery</span>\n  </div>\n  <p class=\"g-sub\">We'll pin your location and send it straight to checkout.</p>\n\n  <div class=\"g-scan\">\n    <svg class=\"g-radar\" viewBox=\"0 0 100 100\" aria-hidden=\"true\">\n      <circle class=\"ring\" cx=\"50\" cy=\"50\" r=\"48\"/>\n      <circle class=\"ring\" cx=\"50\" cy=\"50\" r=\"30\"/>\n      <line class=\"ring\" x1=\"50\" y1=\"2\" x2=\"50\" y2=\"98\"/>\n      <line class=\"ring\" x1=\"2\" y1=\"50\" x2=\"98\" y2=\"50\"/>\n      <circle class=\"ring-live\" cx=\"50\" cy=\"50\" r=\"48\"/>\n      <circle class=\"ring-live\" cx=\"50\" cy=\"50\" r=\"48\"/>\n      <circle class=\"ring-live\" cx=\"50\" cy=\"50\" r=\"48\"/>\n      <g class=\"sweep\">\n        <path d=\"M50 50 L50 2 A48 48 0 0 1 84 16 Z\" fill=\"#22A75B\" opacity=\".15\"/>\n        <line x1=\"50\" y1=\"50\" x2=\"50\" y2=\"2\" stroke=\"#22A75B\" stroke-width=\"1.5\"/>\n      </g>\n      <g class=\"pin\">\n        <circle cx=\"50\" cy=\"50\" r=\"11\" fill=\"#22A75B\" opacity=\".18\"/>\n        <circle cx=\"50\" cy=\"50\" r=\"4.5\" fill=\"#22A75B\" stroke=\"#fff\" stroke-width=\"1.5\"/>\n      </g>\n    </svg>\n    <div class=\"g-meta\">\n      <p class=\"g-status\" id=\"gStatus\">Starting GPS&hellip;</p>\n      <div class=\"g-nums\">\n        <span id=\"gCoords\">--.----- , --.-----</span>\n        <span id=\"gAcc\">± --- m</span>\n      </div>\n      <div class=\"g-bar\"><i id=\"gBar\"></i></div>\n    </div>\n  </div>\n\n  <div class=\"g-result\">\n    <p class=\"g-place\">Ghala, Muscat</p>\n    <p class=\"g-lines\">Ghala 4215, Building 118, Flat 3<br>Ghala Industrial Area · Muscat 133</p>\n    <span class=\"g-ok\">✓ Accurate to 8 m</span>\n  </div>\n\n  <div class=\"g-names\" id=\"gNames\">\n    <label class=\"g-label\" for=\"gFullName\">Full name</label>\n    <input type=\"text\" id=\"gFullName\" placeholder=\"Your name\" autocomplete=\"name\"\n      style=\"width:100%; border:1px solid var(--line); border-radius:8px; padding:11px 12px; font-family:inherit; font-size:14px; outline:0; margin-bottom:6px\">\n    <p class=\"g-err\" id=\"gNameErr\">Enter your name.</p>\n  </div>\n\n  <label class=\"g-label\" for=\"gPhone\">Phone number</label>\n  <div class=\"g-phone\">\n    <span class=\"g-cc\">🇴🇲 +968</span>\n    <input type=\"tel\" id=\"gPhone\" inputmode=\"numeric\" maxlength=\"8\" placeholder=\"\" autocomplete=\"tel-national\">\n  </div>\n  <p class=\"g-err\" id=\"gErr\">Enter your 8-digit Omani number.</p>\n\n  <button type=\"button\" class=\"g-btn\" id=\"gBtn\">Locating&hellip;</button>\n  <button type=\"button\" class=\"g-alt\" id=\"gManual\">Enter address manually</button>\n\n  <!-- modal holds the real Liquid form -->\n  <div class=\"g-modal\" id=\"gModal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"gSheetTitle\">\n    <div class=\"g-sheet\">\n      <div class=\"g-sheet-top\">\n        <h3 class=\"g-sheet-title\" id=\"gSheetTitle\">Delivery address</h3>\n        <button type=\"button\" class=\"g-x\" id=\"gClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      {% form 'customer_address', customer.new_address, return_to: '/checkout', id: 'CartAddressForm' %}\n        <div class=\"g-grid\">\n          <label class=\"g-f\"><span>First name</span>\n            <input type=\"text\" name=\"address[first_name]\" id=\"gf_first\" required></label>\n          <label class=\"g-f\"><span>Last name</span>\n            <input type=\"text\" name=\"address[last_name]\" id=\"gf_last\" required></label>\n          <label class=\"g-f full\"><span>Address</span>\n            <input type=\"text\" name=\"address[address1]\" id=\"gf_a1\" required></label>\n          <label class=\"g-f full\"><span>Apartment, villa, floor</span>\n            <input type=\"text\" name=\"address[address2]\" id=\"gf_a2\"></label>\n          <label class=\"g-f\"><span>City</span>\n            <input type=\"text\" name=\"address[city]\" id=\"gf_city\" required></label>\n          <label class=\"g-f\"><span>Postal code</span>\n            <input type=\"text\" name=\"address[zip]\" id=\"gf_zip\" required></label>\n          <label class=\"g-f full\"><span>Country</span>\n            <select name=\"address[country]\" id=\"gf_country\" required>{{ country_option_tags }}</select></label>\n          <label class=\"g-f full\"><span>Phone</span>\n            <input type=\"tel\" name=\"address[phone]\" id=\"gf_phone\" required></label>\n        </div>\n        <input type=\"hidden\" name=\"address[default]\" value=\"1\">\n        <button type=\"submit\" class=\"g-btn g-save\">Save and checkout</button>\n      {% endform %}\n    </div>\n  </div>\n</div>\n\n<script>\n(function(){\n  var root = document.getElementById('beisat-geo');\n  var statusEl = document.getElementById('gStatus');\n  var coordsEl = document.getElementById('gCoords');\n  var accEl    = document.getElementById('gAcc');\n  var barEl    = document.getElementById('gBar');\n  var phoneEl  = document.getElementById('gPhone');\n  var errEl    = document.getElementById('gErr');\n  var btn      = document.getElementById('gBtn');\n  var modal    = document.getElementById('gModal');\n  var formEl   = document.getElementById('CartAddressForm');\n\n  {%- comment -%}\n    Social sign-in DOES populate first_name/last_name, but only when it creates\n    the customer profile. Existing profiles (e.g. created earlier via email code)\n    stay empty and are never backfilled.\n    Priority: name saved on their address (their own edit) > account name from\n    the social provider > guess from the email prefix.\n  {%- endcomment -%}\n  {%- assign addr_name = customer.default_address.first_name | append: ' ' | append: customer.default_address.last_name | strip -%}\n  {%- assign c_saved   = addr_name | default: customer.name -%}\n  {%- assign c_phone   = customer.phone | default: customer.default_address.phone -%}\n\n  var ACCOUNT = {\n    saved: {{ c_saved | default: '' | json }},\n    email: {{ customer.email | default: '' | json }},\n    phone: {{ c_phone | default: '' | json }}\n  };\n\n  // treat whitespace-only and the literal string \"null\" as missing\n  function clean(v){\n    v = (v == null ? '' : String(v)).trim();\n    return (v === '' || v.toLowerCase() === 'null') ? '' : v;\n  }\n  ACCOUNT.saved = clean(ACCOUNT.saved);\n  ACCOUNT.email = clean(ACCOUNT.email);\n  ACCOUNT.phone = clean(ACCOUNT.phone);\n\n  // customer.name can echo the email when no name is set — that isn't a name\n  if (ACCOUNT.saved.indexOf('@') !== -1) ACCOUNT.saved = '';\n\n  // \"ahmed.al_balushi92@gmail.com\" -> \"Ahmed Al Balushi\"\n  function nameFromEmail(email){\n    var local = email.split('@')[0] || '';\n    return local\n      .replace(/[._\\-+]+/g, ' ')     // separators become spaces\n      .replace(/\\d+/g, '')           // drop trailing digits\n      .replace(/\\s+/g, ' ')\n      .trim()\n      .replace(/\\b\\w/g, function(ch){ return ch.toUpperCase(); });\n  }\n\n  var nameEl  = document.getElementById('gFullName');\n  var nameErr = document.getElementById('gNameErr');\n\n  nameEl.value = ACCOUNT.saved || nameFromEmail(ACCOUNT.email);\n\n  function resolvedName(){\n    // full name goes in last_name; first_name stays empty\n    return { first: '', last: nameEl.value.trim() };\n  }\n\n  var TARGET = { lat:23.578912, lng:58.319644 };\n  var DEMO = {\n    address1:'Ghala 4215, Building 118', address2:'Flat 3',\n    city:'Muscat', country:'Oman', zip:'133'\n  };\n\n  var TARGET = { lat:23.578912, lng:58.319644 };\n  var DEMO = {\n    address1:'Ghala 4215, Building 118', address2:'Flat 3',\n    city:'Muscat', country:'Oman', zip:'133'\n  };\n\n  var SCRIPT = [\n    { at:0,    msg:'Waking up GPS\\u2026',             acc:null, pct:8  },\n    { at:800,  msg:'4 satellites locked',             acc:520,  pct:28 },\n    { at:1700, msg:'9 satellites locked',             acc:120,  pct:52 },\n    { at:2600, msg:'Narrowing to street level\\u2026', acc:31,   pct:76 },\n    { at:3500, msg:'Matching delivery zone\\u2026',    acc:12,   pct:92 }\n  ];\n\n  var timers = [], drift = null, located = false, prevState = 'idle';\n  function clearAll(){ timers.forEach(clearTimeout); timers = []; if (drift) clearInterval(drift); }\n  function later(fn, ms){ timers.push(setTimeout(fn, ms)); }\n\n  nameEl.addEventListener('input', function(){ nameErr.classList.remove('show'); });\n\n  phoneEl.addEventListener('input', function(){\n    this.value = this.value.replace(/\\D/g,'').slice(0,8);\n    errEl.classList.remove('show');\n  });\n\n  function jitter(b,s){ return (b + (Math.random()-0.5)*s).toFixed(5); }\n\n  function fillForm(){\n    var n = resolvedName();\n    document.getElementById('gf_first').value = n.first;\n    document.getElementById('gf_last').value  = n.last;\n    document.getElementById('gf_a1').value    = DEMO.address1;\n    document.getElementById('gf_a2').value    = DEMO.address2;\n    document.getElementById('gf_city').value  = DEMO.city;\n    document.getElementById('gf_zip').value   = DEMO.zip;\n    document.getElementById('gf_phone').value = phoneEl.value ? '+968' + phoneEl.value : '';\n    var sel = document.getElementById('gf_country');\n    for (var i=0;i<sel.options.length;i++){\n      if (sel.options[i].value === DEMO.country){ sel.selectedIndex = i; break; }\n    }\n  }\n\n  function setStatus(t){\n    statusEl.classList.add('fade');\n    setTimeout(function(){ statusEl.textContent = t; statusEl.classList.remove('fade'); }, 160);\n  }\n\n  function go(){\n    var n = resolvedName();\n    if (!n.last){\n      nameErr.classList.add('show');\n      nameEl.focus();\n      return;\n    }\n    if (phoneEl.value.length !== 8){ errEl.classList.add('show'); phoneEl.focus(); return; }\n    fillForm();\n    formEl.submit();\n  }\n\n  function startScan(){\n    root.dataset.state = 'scanning';\n    btn.textContent = 'Locating\\u2026';\n\n    var spread = 0.07;\n    drift = setInterval(function(){\n      coordsEl.textContent = jitter(TARGET.lat, spread) + ' , ' + jitter(TARGET.lng, spread);\n      spread *= 0.84;\n    }, 110);\n\n    SCRIPT.forEach(function(s){\n      later(function(){\n        setStatus(s.msg);\n        barEl.style.width = s.pct + '%';\n        if (s.acc !== null) accEl.textContent = '\\u00B1 ' + s.acc + ' m';\n      }, s.at);\n    });\n\n    later(function(){\n      clearInterval(drift); drift = null;\n      coordsEl.textContent = TARGET.lat.toFixed(5) + ' , ' + TARGET.lng.toFixed(5);\n      accEl.textContent = '\\u00B1 8 m';\n      barEl.style.width = '100%';\n      root.dataset.state = 'found';\n      located = true;\n      setStatus('Found you in Ghala');\n      btn.textContent = 'Continue to checkout';\n      fillForm();\n      if (phoneEl.value.length !== 8){ phoneEl.focus(); }\n    }, 4000);\n\n  }\n\n  btn.addEventListener('click', function(){\n    if (located) go();\n  });\n\n  // ---- manual entry ----\n  function openModal(){\n    clearAll();\n    prevState = root.dataset.state;\n    root.dataset.state = 'manual';\n    setStatus('Entering address manually');\n    modal.classList.add('open');\n    document.body.style.overflow = 'hidden';\n    if (phoneEl.value.length === 8) document.getElementById('gf_phone').value = '+968' + phoneEl.value;\n    var sel = document.getElementById('gf_country');\n    for (var i=0;i<sel.options.length;i++){\n      if (sel.options[i].value === 'Oman'){ sel.selectedIndex = i; break; }\n    }\n    setTimeout(function(){ document.getElementById('gf_first').focus(); }, 120);\n  }\n  function closeModal(){\n    modal.classList.remove('open');\n    document.body.style.overflow = '';\n    if (located){\n      root.dataset.state = 'found';\n      setStatus('Found you in Ghala');\n      btn.textContent = 'Continue to checkout';\n    } else {\n      startScan();\n    }\n  }\n\n  document.getElementById('gManual').addEventListener('click', openModal);\n  document.getElementById('gClose').addEventListener('click', closeModal);\n  modal.addEventListener('click', function(e){ if (e.target === modal) closeModal(); });\n  document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && modal.classList.contains('open')) closeModal(); });\n\n  // ---- prefill from the account ----\n  if (ACCOUNT.phone){\n    var digits = ACCOUNT.phone.replace(/\\D/g,'').replace(/^968/,'');\n    if (digits.length >= 8) phoneEl.value = digits.slice(-8);\n  }\n  if (ACCOUNT.saved){\n    document.querySelector('#beisat-geo .g-sub').textContent =\n      'Welcome back, ' + ACCOUNT.saved.split(' ')[0] + '. Confirm your details below.';\n  }\n\n  // ---- auto-start on load ----\n  if (document.readyState === 'loading'){\n    document.addEventListener('DOMContentLoaded', function(){ setTimeout(startScan, 400); });\n  } else {\n    setTimeout(startScan, 400);\n  }\n})();\n</script>\n{% endif %}"
      }
    },
